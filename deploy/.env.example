# Required: DNS hostname only. No https://, path, port or trailing slash.
SEARCHOS_DOMAIN=searchos.example.com
# Your real contact email (certificate registration and Web Push).
SEARCHOS_EMAIL=you@example.com
SEARCHOS_TIMEZONE=Asia/Shanghai

# First deployment builds from this checkout. Published images are optional:
# SEARCHOS_API_IMAGE=ghcr.io/YOUR_OWNER/searchos-api:VERSION
# SEARCHOS_WEB_IMAGE=ghcr.io/YOUR_OWNER/searchos-web:VERSION
# Keep model/search keys out of this file: enter them in the authenticated UI.
